/* 专家咨询页面样式 */

/* 页面容器 */
.consult-container {
  min-height: 100vh;
  background-color: #F5F6F8;
  padding-bottom: 120rpx;
}

/* ========== 顶部说明区域 ========== */
.notice-card {
  margin: 24rpx;
  padding: 32rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

/* 说明标题 */
.notice-title {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.5;
}

/* 绿色提示文字 */
.notice-tip {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #2B8C5A;
  font-weight: bold;
}

/* ========== 留言表单区域 ========== */
.form-card {
  margin: 24rpx;
  padding: 32rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

/* 表单项 */
.form-item {
  margin-bottom: 32rpx;
}

/* 最后一个表单项不需要底部间距 */
.form-item:last-of-type {
  margin-bottom: 0;
}

/* 表单标签 */
.form-label {
  font-size: 28rpx;
  color: #333333;
  font-weight: bold;
  margin-bottom: 16rpx;
}

/* 问题类型下拉选择器 */
.picker-value {
  padding: 20rpx 24rpx;
  background-color: #F5F6F8;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333333;
}

/* 选择器placeholder样式 */
.picker-value.placeholder {
  color: #bbbbbb;
}

/* 问题描述文本域 */
.form-textarea {
  width: 100%;
  height: 200rpx;
  padding: 24rpx;
  background-color: #F5F6F8;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
  box-sizing: border-box;
}

/* textarea placeholder样式 */
.textarea-placeholder {
  color: #bbbbbb;
  font-size: 28rpx;
}

/* 字数统计 */
.char-count {
  text-align: right;
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* ========== 图片上传区域 ========== */
.image-upload-area {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

/* 已上传的图片项 */
.image-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

/* 上传的图片 */
.upload-image {
  width: 100%;
  height: 100%;
}

/* 删除按钮（图片右上角） */
.image-delete {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-icon {
  color: #ffffff;
  font-size: 22rpx;
}

/* 添加图片按钮（虚线边框方框） */
.image-add {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed #cccccc;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #F5F6F8;
}

/* 加号 */
.add-icon {
  font-size: 60rpx;
  color: #999999;
  line-height: 1;
}

/* ========== 提交按钮 ========== */
.submit-btn {
  margin-top: 32rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #2B8C5A;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 16rpx;
  text-align: center;
  border: none;
}

/* 提交按钮禁用状态 */
.submit-btn[disabled] {
  background-color: #a8d5ba;
  color: #ffffff;
}

/* ========== 历史留言列表 ========== */
.history-section {
  margin: 0 24rpx;
}

/* 分区标题 */
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 16rpx;
}

/* 历史列表 */
.history-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 历史卡片 */
.history-card {
  padding: 24rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

/* 卡片头部 */
.history-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

/* 问题类型标签 */
.history-type-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  background-color: #e8f5e9;
  color: #2B8C5A;
  flex-shrink: 0;
}

/* 状态标签 */
.history-status {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

/* 已回复 - 绿色 */
.status-replied {
  background-color: #f6ffed;
  color: #52C41A;
}

/* 待回复 - 灰色 */
.status-pending {
  background-color: #f5f5f5;
  color: #999999;
}

/* 时间 */
.history-time {
  font-size: 22rpx;
  color: #999999;
  margin-left: auto;
}

/* 问题内容（截取前两行） */
.history-content {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ========== 回复内容（展开时显示） ========== */
.history-reply {
  margin-top: 16rpx;
}

/* 分隔线 */
.reply-divider {
  height: 1rpx;
  background-color: #f0f0f0;
  margin-bottom: 16rpx;
}

/* 回复标签 */
.reply-label {
  font-size: 26rpx;
  color: #2B8C5A;
  font-weight: bold;
  margin-bottom: 8rpx;
}

/* 回复正文 */
.reply-text {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
}

/* ========== 底部企业微信按钮 ========== */
.wechat-btn-wrapper {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background-color: #ffffff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.wechat-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #ffffff;
  color: #2B8C5A;
  font-size: 30rpx;
  font-weight: bold;
  border: 2rpx solid #2B8C5A;
  border-radius: 16rpx;
  text-align: center;
}