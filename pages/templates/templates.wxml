<!-- 乡农合规通 - 模板下载页 -->
<view class="page-container">

  <!-- 1. 顶部说明 -->
  <view class="page-desc">
    <text>下载规范模板，轻松完成合规准备</text>
  </view>

  <!-- 2. 模板分类tabs - 横向滚动 -->
  <scroll-view class="tabs-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="tabs-inner">
      <view
        class="tab-item {{currentTab === index ? 'active' : ''}}"
        wx:for="{{tabs}}"
        wx:key="*this"
        data-index="{{index}}"
        bindtap="onTabChange"
      >{{item}}</view>
    </view>
  </scroll-view>

  <!-- 3. 模板列表 -->
  <view class="template-list" wx:if="{{filteredList.length > 0}}">
    <view
      class="template-card"
      wx:for="{{filteredList}}"
      wx:key="id"
    >
      <!-- 左侧：文件类型图标 -->
      <view class="file-icon-wrap">
        <!-- 根据文件后缀显示不同颜色图标 -->
        <view class="file-icon file-icon-{{item.format}}">
          <text class="file-icon-text">{{item.format}}</text>
        </view>
      </view>

      <!-- 中间：模板信息 -->
      <view class="template-info">
        <text class="template-name">{{item.name}}</text>
        <view class="template-meta">
          <!-- 文件格式标签 -->
          <text class="format-tag format-tag-{{item.format}}">{{item.format}}</text>
          <!-- 下载次数 -->
          <text class="download-count">{{item.downloads}}次下载</text>
        </view>
      </view>

      <!-- 右侧：下载按钮 -->
      <view
        class="btn-download-small"
        data-url="{{item.url}}"
        data-name="{{item.name}}"
        data-format="{{item.format}}"
        bindtap="downloadTemplate"
      >
        <text class="btn-download-text">下载</text>
      </view>
    </view>
  </view>

  <!-- 4. 空状态 -->
  <view class="empty-state" wx:if="{{filteredList.length === 0}}">
    <text class="empty-text">暂无可用模板</text>
  </view>

  <!-- 5. 底部提示（固定底部） -->
  <view class="bottom-tip">
    <text class="bottom-tip-text">文件打开后，点击右上角"..."可保存到手机或转发给好友</text>
  </view>

</view>