/**
 * 拍照识别页样式 - 乡农合规通
 */

/* 顶部说明文字 */
.scan-tip {
  text-align: center;
  color: #999999;
  font-size: 28rpx;
  padding: 30rpx 40rpx 20rpx;
}

/* 图片预览区域 */
.preview-area {
  width: 90%;
  margin: 20rpx auto 0;
  height: 500rpx;
  background: #f5f5f5;
  border: 4rpx dashed #cccccc;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

/* 已有图片时边框变为实线 */
.preview-area.has-image {
  border-style: solid;
  border-color: #2B8C5A;
}

/* 预览图片 */
.preview-image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

/* 右上角删除按钮 */
.delete-btn {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 40rpx;
  height: 40rpx;
  background: #FF4D4F;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

/* 删除按钮中的 × 图标 */
.delete-icon {
  color: #ffffff;
  font-size: 28rpx;
  line-height: 1;
  margin-top: -2rpx;
}

/* 未选图片时的占位提示 */
.preview-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 占位图标 */
.placeholder-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

/* 占位文字 */
.placeholder-text {
  color: #bbbbbb;
  font-size: 26rpx;
}

/* ========== 底部操作区域 ========== */
.bottom-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

/* 拍照 / 相册 横排容器 */
.action-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

/* 描边按钮（拍照/相册） */
.btn-outline {
  width: 48%;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 28rpx;
  color: #2B8C5A;
  border: 2rpx solid #2B8C5A;
  border-radius: 12rpx;
  background: #ffffff;
}

/* 描边按钮点击态 */
.btn-outline:active {
  background: #f0faf5;
}

/* 绿色实心主按钮（开始识别） */
.btn-primary {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  background: #2B8C5A;
  border-radius: 12rpx;
}

/* 主按钮点击态 */
.btn-primary:active {
  background: #237a4d;
}

/* 主按钮禁用态（上传中） */
.btn-primary.btn-disabled {
  background: #a0d4b8;
  color: #ffffff;
}