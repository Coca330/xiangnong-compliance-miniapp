/* 风险徽章 - 根据等级显示不同颜色 */
.risk-badge {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 24rpx;
  border-radius: var(--radius-round, 999rpx);
  font-size: 26rpx;
  font-weight: 600;
}

.risk-badge__dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.risk-badge__text {
  line-height: 1;
}

/* 绿色 - 初级农产品 */
.risk-badge--green {
  background: #F6FFED;
  color: #389E0D;
}
.risk-badge--green .risk-badge__dot {
  background: #52C41A;
}

/* 黄色 - 初加工农产品 */
.risk-badge--yellow {
  background: #FFFBE6;
  color: #D48806;
}
.risk-badge--yellow .risk-badge__dot {
  background: #FAAD14;
}

/* 红色 - 预包装/深加工食品 */
.risk-badge--red {
  background: #FFF2F0;
  color: #CF1322;
}
.risk-badge--red .risk-badge__dot {
  background: #FF4D4F;
}