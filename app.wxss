/**
 * 乡农合规通 - 全局样式
 * 定义CSS变量、公共样式类、适配中老年用户的大字体方案
 */

/* ========== CSS 变量 ========== */
page {
  /* 品牌色 */
  --color-primary: #2B8C5A;
  --color-primary-light: #E8F5EE;
  --color-primary-dark: #1E6B42;

  /* 风险等级色 */
  --color-risk-green: #52C41A;
  --color-risk-green-bg: #F6FFED;
  --color-risk-yellow: #FAAD14;
  --color-risk-yellow-bg: #FFFBE6;
  --color-risk-red: #FF4D4F;
  --color-risk-red-bg: #FFF2F0;

  /* 中性色 */
  --color-text-primary: #333333;
  --color-text-secondary: #666666;
  --color-text-hint: #999999;
  --color-border: #E5E5E5;
  --color-bg: #F5F6F8;
  --color-bg-white: #FFFFFF;

  /* 间距 */
  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 40rpx;

  /* 圆角 */
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-round: 999rpx;

  /* 字体大小 - 适配中老年，整体偏大 */
  --font-xs: 24rpx;
  --font-sm: 26rpx;
  --font-md: 30rpx;
  --font-lg: 34rpx;
  --font-xl: 40rpx;
  --font-xxl: 48rpx;

  /* 阴影 */
  --shadow-card: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  --shadow-btn: 0 4rpx 12rpx rgba(43, 140, 90, 0.3);

  /* 页面基础样式 */
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: var(--font-md);
  color: var(--color-text-primary);
  background-color: var(--color-bg);
  box-sizing: border-box;
  line-height: 1.6;
}

/* ========== 公共工具类 ========== */

/* 弹性布局 */
.flex { display: flex; }
.flex-col { display: flex; flex-direction: column; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-wrap { display: flex; flex-wrap: wrap; }
.flex-1 { flex: 1; }
.align-center { align-items: center; }

/* 文本 */
.text-center { text-align: center; }
.text-right { text-align: right; }
.text-primary { color: var(--color-primary); }
.text-secondary { color: var(--color-text-secondary); }
.text-hint { color: var(--color-text-hint); }
.text-bold { font-weight: 600; }
.text-sm { font-size: var(--font-sm); }
.text-lg { font-size: var(--font-lg); }
.text-xl { font-size: var(--font-xl); }

/* 间距 */
.mt-sm { margin-top: var(--spacing-sm); }
.mt-md { margin-top: var(--spacing-md); }
.mt-lg { margin-top: var(--spacing-lg); }
.mb-sm { margin-bottom: var(--spacing-sm); }
.mb-md { margin-bottom: var(--spacing-md); }
.mb-lg { margin-bottom: var(--spacing-lg); }
.p-sm { padding: var(--spacing-sm); }
.p-md { padding: var(--spacing-md); }
.p-lg { padding: var(--spacing-lg); }
.px-md { padding-left: var(--spacing-md); padding-right: var(--spacing-md); }
.py-md { padding-top: var(--spacing-md); padding-bottom: var(--spacing-md); }

/* 卡片 */
.card {
  background: var(--color-bg-white);
  border-radius: var(--radius-md);
  padding: var(--spacing-lg);
  margin: var(--spacing-md);
  box-shadow: var(--shadow-card);
}

/* 按钮 */
.btn-primary {
  background: var(--color-primary);
  color: #ffffff;
  border-radius: var(--radius-round);
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: var(--font-lg);
  font-weight: 600;
  box-shadow: var(--shadow-btn);
}
.btn-primary::after { border: none; }

.btn-outline {
  background: var(--color-bg-white);
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
  border-radius: var(--radius-round);
  height: 88rpx;
  line-height: 84rpx;
  text-align: center;
  font-size: var(--font-lg);
  font-weight: 600;
}
.btn-outline::after { border: none; }

/* 分割线 */
.divider {
  height: 1rpx;
  background: var(--color-border);
  margin: var(--spacing-md) 0;
}

/* 安全区域底部 */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* 禁用状态 */
.disabled {
  opacity: 0.5;
  pointer-events: none;
}